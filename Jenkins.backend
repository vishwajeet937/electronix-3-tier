pipeline{
    agent {label 'electronix'}

    environment {
        ECR_REPO='127677820228.dkr.ecr.eu-west-1.amazonaws.com/electronix-ecr'
        AWS_REGION = "US-EAST-1"
    }
    stages{
        stages("Test ECR Login"){
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username.AWS --password-stdin.${ECR_REPO}
                '''
            }
        }
    }
    post{
     success{
        "ECR LOGIN SUCCESS✅"
     }
     failur{
        "ECR LOGIN Failed❌"
     }
    }
}