pipeline{
    agent {label 'electronix'}

    environment {
        ECR_REPO='127677820228.dkr.ecr.eu-west-1.amazonaws.com/electronix-ecr'
        AWS_REGION = "eu-west-1"
        PRODUCTION_IP= 52.209.33.145
    }
    stage('Backend Pipeline'){
       //  when {
       //    changeset "backend/**"
       // }
    }
    stages{
        stage('Buold Docker Image'){
            steps{
                dir("backend"){
                    sh 'docker build -t electronix-backend:${BUILD_NUMBER}'
                }
            }
        }
        stages("Test ECR Login"){
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username.AWS --password-stdin.${ECR_REPO}
                '''
            }
        }
        stage ("Tag & Push to ECR"){
            steps{
                sh '''
                sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker tag electronix-backend:${ECR}:latest
                sudo docker Push ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker Push ${ECR_REPO}:latest

                echo "push success✅"
                '''
            }
        }
    }
}
    post{
     success{
        "ECR LOGIN SUCCESS✅"
     }
     failur{
        "ECR LOGIN Failed❌"
     }
    }
